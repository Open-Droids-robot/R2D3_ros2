{
  "name": "R2D3 simulation workspace",
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "dockerComposeFile": [
    "docker-compose.resolved.yml",
    "docker-compose.dev.yml"
  ],
  "service": "sim",
  "workspaceFolder": "/ws/src/R2D3_ros2",
  "remoteUser": "droid",
  "overrideCommand": false,
  "shutdownAction": "none",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-vscode.cpptools",
        "twxs.cmake",
        "ms-iot.vscode-ros",
        "redhat.vscode-yaml",
        "smilerobotics.urdf"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/bin/python3",
        "python.analysis.extraPaths": [
          "/opt/ros/jazzy/lib/python3.12/site-packages",
          "/ws/install/rm_ros_interfaces/lib/python3.12/site-packages",
          "/ws/install/servo_interfaces/lib/python3.12/site-packages",
          "/ws/install/servo_sim_bridge/lib/python3.12/site-packages"
        ],
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/opt/ros/jazzy/include/**",
          "/ws/install/**/include/**"
        ],
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.cStandard": "c17",
        "ros.distro": "jazzy",
        "files.watcherExclude": {
          "**/build/**": true,
          "**/install/**": true,
          "**/log/**": true
        },
        "files.associations": {
          "*.xacro": "xml",
          "*.urdf": "xml",
          "*.sdf": "xml",
          "*.world": "xml",
          "*.launch": "xml",
          "*.repos": "yaml"
        }
      }
    }
  }
}
